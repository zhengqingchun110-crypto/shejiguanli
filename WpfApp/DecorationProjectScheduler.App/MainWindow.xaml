<Window x:Class="DecorationProjectScheduler.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DecorationProjectScheduler.App.Models;assembly=DecorationProjectScheduler.Shared"
        mc:Ignorable="d"
        Title="装饰设计项目与人员排期管理系统"
        Width="1580"
        Height="960"
        MinWidth="1320"
        MinHeight="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="PeopleDepartmentTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewEmployeeName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="添加"
                                Margin="10,0,0,10"
                                MinWidth="72"
                                Command="{Binding DataContext.AddEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2"
                                Content="保存"
                                Margin="8,0,0,10"
                                MinWidth="72"
                                Command="{Binding DataContext.SavePersonnelRowsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </Grid>

                <ItemsControl ItemsSource="{Binding EmployeeGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:EmployeeWorkGroup}">
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="22"
                                    Padding="18"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding EmployeeName}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Content="+"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.AddProjectRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2"
                                                Content="×"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.RemoveEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ProjectRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:EmployeeProjectRow}">
                                                <Border Background="{DynamicResource PanelBrush}"
                                                        CornerRadius="18"
                                                        Padding="14"
                                                        Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.45*" />
                                                            <ColumnDefinition Width="3.2*" />
                                                            <ColumnDefinition Width="1.8*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Background="{Binding TagColor}"
                                                                CornerRadius="16"
                                                                Padding="6"
                                                                Margin="0,0,10,0">
                                                            <ComboBox ItemsSource="{Binding DataContext.ProjectOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding SelectedProject, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      ItemContainerStyle="{StaticResource FrostedComboBoxItemStyle}"
                                                                      Style="{StaticResource FrostedComboBoxStyle}"
                                                                      Margin="0" />
                                                        </Border>

                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding CurrentTask, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 Style="{StaticResource RoundedTaskTextBoxStyle}"
                                                                 FontSize="15"
                                                                 Margin="0,0,12,0"
                                                                 VerticalContentAlignment="Center" />

                                                        <Grid Grid.Column="2"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.35*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="#B8FFFFFF"
                                                                    BorderBrush="#88FFFFFF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="14"
                                                                    Padding="9,5"
                                                                    Height="34"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0">
                                                                <DatePicker SelectedDate="{Binding SubmissionDate, UpdateSourceTrigger=PropertyChanged}"
                                                                            SelectedDateFormat="Short"
                                                                            Language="zh-CN" />
                                                            </Border>

                                                            <Border Grid.Column="1"
                                                                    Background="#EEF3F4F7"
                                                                    CornerRadius="14"
                                                                    Padding="8,5"
                                                                    Height="34"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DaysUntilSubmissionText}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>

                                                        <Button Grid.Column="3"
                                                                Content="完成"
                                                                Style="{StaticResource SmallPillButtonStyle}"
                                                                Command="{Binding DataContext.CompleteProjectRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Grid.Column="4"
                                                                Content="删除"
                                                                Style="{StaticResource SmallPillButtonStyle}"
                                                                Command="{Binding DataContext.RemoveProjectRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#EEF3F4F7"
                        CornerRadius="18"
                        Padding="14"
                        Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导出当前部门人员排期"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="导出表格"
                                MinWidth="110"
                                Command="{Binding DataContext.ExportDepartmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type models:ProjectYearGroup}" ItemsSource="{Binding Months}">
            <TextBlock Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Padding="4,8" />
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type models:ProjectMonthGroup}" ItemsSource="{Binding Projects}">
            <TextBlock Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Padding="4,7" />
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:ProjectSummary}">
            <TextBlock Text="{Binding Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Padding="4,8" />
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="Both">
    <Grid Width="1580"
          Height="960"
          Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="20"
                Style="{StaticResource PanelBorderStyle}"
                Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="项目排期系统"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Text="装饰设计排期"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,10,0,6" />
                    <TextBlock Text="项目、人员与资料的统一入口。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,28,0,24">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NavigationMenuItem}">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Padding="6,10"
                                       Margin="0,2,0,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="18"
                        Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{Binding ConnectionIndicatorBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ConnectionStatusText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding LastSyncText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding NonProjectContentVisibility}">
            <Grid Margin="8,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,18" Visibility="{Binding OverviewVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="人员管理优先"
                                           FontSize="34"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1"
                                        Content="同步"
                                        MinWidth="96"
                                        Command="{Binding SyncNowCommand}" />
                            </Grid>
                            <TextBlock Text="先看公司成员和正在做的工作，再管理项目、巡场、验收与资料。"
                                        Margin="0,10,0,0"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="22"
                                Background="{DynamicResource AccentSoftBrush}"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="最近更新"
                                           FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding RecentUpdates}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RecentProjectUpdate}">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding DashboardCards}"
                              Margin="0,0,0,18"
                              Visibility="{Binding OverviewVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DashboardCard}">
                            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,8" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2">
                    <Border Style="{StaticResource PanelBorderStyle}" Visibility="{Binding PeopleVisibility}">
                        <TabControl ItemsSource="{Binding DepartmentPages}"
                                    SelectedItem="{Binding SelectedDepartmentPage}"
                                    Style="{StaticResource DepartmentTabControlStyle}"
                                    ItemContainerStyle="{StaticResource DepartmentTabItemStyle}"
                                    ContentTemplate="{StaticResource PeopleDepartmentTemplate}" />
                    </Border>

                    <Border Style="{StaticResource PanelBorderStyle}" Visibility="{Binding FilesVisibility}">
                        <StackPanel>
                            <TextBlock Text="资料中心"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="按项目编号与资料分类管理文件。"
                                       Margin="0,8,0,14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding FileCategories}" SelectedItem="{Binding SelectedFileCategory}" />
                            <TextBox Text="{Binding NewFileName}" />
                            <TextBox Text="{Binding NewFilePath}" />
                            <Button Content="登记资料" Command="{Binding AddFileRecordCommand}" />

                            <DataGrid ItemsSource="{Binding SelectedProjectFiles}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Height="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="100" />
                                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Column="1"
                Margin="8,20,20,20"
                Style="{StaticResource PanelBorderStyle}"
                Visibility="{Binding ProjectCenterVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="项目中心"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="按年份、月份和项目名称归档，右侧查看项目详情和完成进度。"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#EEF3F4F7"
                            CornerRadius="20"
                            Padding="16"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            MinWidth="560">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="项目名" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="请输入项目名字"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding NewProjectType, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="请输入项目类型"
                                     Margin="0,0,10,0" />
                            <Button Grid.Column="4"
                                    Content="创建项目"
                                    MinWidth="120"
                                    Margin="0"
                                    Command="{Binding CreateProjectCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#EEF3F4F7"
                            CornerRadius="24"
                            Padding="16"
                            Margin="0">
                        <TreeView ItemsSource="{Binding ProjectTreeGroups}"
                                  SelectedItemChanged="ProjectTree_SelectedItemChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="17" />
                    </Border>

                    <Border Grid.Column="2"
                            Background="#F7F8FA"
                            CornerRadius="24"
                            Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EditableProjectName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="28"
                                             FontWeight="SemiBold"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="×"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DeleteSelectedProjectCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EditableProjectOperators, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="请输入操作人员"
                                             Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditableProjectType, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="请输入项目类型"
                                             Margin="0,0,10,0" />
                                    <Button Grid.Column="2"
                                            Content="保存"
                                            Command="{Binding SaveProjectDetailCommand}" />
                                </Grid>

                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="项目详情" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBox Text="{Binding EditableProjectSummary, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="请输入项目详情内容"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="180"
                                                 VerticalContentAlignment="Top" />
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="跟进计划" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <TextBox Text="{Binding EditableTaskPlanText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="请输入项目的跟进计划"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     MinHeight="320"
                                                     VerticalContentAlignment="Top" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="跟进完成进度" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <ItemsControl ItemsSource="{Binding SelectedProjectFollowUps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ProjectFollowUp}">
                                                        <Border Background="#EEF3F4F7" CornerRadius="16" Padding="12" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Content}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                        <Run Text="{Binding OperatorName}" />
                                                                        <Run Text="  ·  " />
                                                                        <Run Text="{Binding CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Content="×"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Margin="10,0,0,0"
                                                                        Command="{Binding DataContext.DeleteProjectFollowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>


