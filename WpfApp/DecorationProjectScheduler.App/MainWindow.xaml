<Window x:Class="DecorationProjectScheduler.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:DecorationProjectScheduler.App.Helpers"
        xmlns:models="clr-namespace:DecorationProjectScheduler.App.Models;assembly=DecorationProjectScheduler.Shared"
        mc:Ignorable="d"
        Title="凡响智道"
        Width="1580"
        Height="960"
        MinWidth="1320"
        MinHeight="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="PeopleDepartmentTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="520" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewEmployeeName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Content="添加"
                                Margin="10,0,0,10"
                                MinWidth="72"
                                Command="{Binding DataContext.AddEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2"
                                Content="保存"
                                Margin="8,0,0,10"
                                MinWidth="72"
                                Command="{Binding DataContext.SavePersonnelRowsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                </Grid>

                <ItemsControl ItemsSource="{Binding EmployeeGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:EmployeeWorkGroup}">
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="22"
                                    Padding="18"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding EmployeeName}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <Button Grid.Column="1"
                                                Content="+"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.AddProjectRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2"
                                                Content="×"
                                                Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.RemoveEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ProjectRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:EmployeeProjectRow}">
                                                <Border Background="{DynamicResource PanelBrush}"
                                                        CornerRadius="18"
                                                        Padding="14"
                                                        Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.45*" />
                                                            <ColumnDefinition Width="3.2*" />
                                                            <ColumnDefinition Width="1.8*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Background="{Binding TagColor}"
                                                                CornerRadius="16"
                                                                Padding="6"
                                                                Margin="0,0,10,0">
                                                            <ComboBox ItemsSource="{Binding DataContext.ProjectOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding SelectedProject, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      ItemContainerStyle="{StaticResource FrostedComboBoxItemStyle}"
                                                                      Style="{StaticResource FrostedComboBoxStyle}"
                                                                      Margin="0" />
                                                        </Border>

                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding CurrentTask, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 Style="{StaticResource RoundedTaskTextBoxStyle}"
                                                                 FontSize="15"
                                                                 Margin="0,0,12,0"
                                                                 VerticalContentAlignment="Center" />

                                                        <Grid Grid.Column="2"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="1.35*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Background="#B8FFFFFF"
                                                                    BorderBrush="#88FFFFFF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="14"
                                                                    Padding="9,5"
                                                                    Height="34"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0">
                                                                <DatePicker SelectedDate="{Binding SubmissionDate, UpdateSourceTrigger=PropertyChanged}"
                                                                            SelectedDateFormat="Short"
                                                                            Language="zh-CN" />
                                                            </Border>

                                                            <Border Grid.Column="1"
                                                                    Background="#EEF3F4F7"
                                                                    CornerRadius="14"
                                                                    Padding="8,5"
                                                                    Height="34"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DaysUntilSubmissionText}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>

                                                        <Button Grid.Column="3"
                                                                Content="完成"
                                                                Style="{StaticResource SmallPillButtonStyle}"
                                                                Command="{Binding DataContext.CompleteProjectRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Grid.Column="4"
                                                                Content="删除"
                                                                Style="{StaticResource SmallPillButtonStyle}"
                                                                Command="{Binding DataContext.RemoveProjectRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#EEF3F4F7"
                        CornerRadius="18"
                        Padding="14"
                        Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导出当前部门人员排期"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="导出PDF"
                                MinWidth="110"
                                Command="{Binding DataContext.ExportDepartmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type models:ProjectYearGroup}" ItemsSource="{Binding Months}">
            <TextBlock Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Padding="4,8" />
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type models:ProjectMonthGroup}" ItemsSource="{Binding Projects}">
            <TextBlock Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Padding="4,7" />
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:ProjectSummary}">
            <TextBlock Text="{Binding Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Padding="4,8" />
        </DataTemplate>
    </Window.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="Both">
    <Grid Width="1580"
          Height="960"
          Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="20"
                Style="{StaticResource PanelBorderStyle}"
                Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="凡响智道"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock Text="项目管理"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,10,0,6" />
                    <TextBlock Text="项目、人员与资料的统一入口。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigation}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,28,0,24">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NavigationMenuItem}">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Padding="6,10"
                                       Margin="0,2,0,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="18"
                            Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10"
                                         Height="10"
                                         Fill="{Binding ConnectionIndicatorBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ConnectionStatusText}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding LastSyncText}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="1"
                            Content="⚙"
                            Style="{StaticResource SettingsGearButtonStyle}"
                            VerticalAlignment="Bottom"
                            Command="{Binding OpenSettingsCommand}" />
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding NonProjectContentVisibility}">
            <Grid Margin="8,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,18" Visibility="{Binding OverviewVisibility}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="凡响智道项目管理"
                                           FontSize="34"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1"
                                        Content="同步"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource DashboardActionButtonStyle}"
                                        Command="{Binding SyncNowCommand}" />
                                <Button Grid.Column="2"
                                        Content="检查更新"
                                        Style="{StaticResource DashboardActionButtonStyle}"
                                        Command="{Binding CheckUpdateCommand}" />
                            </Grid>
                            <TextBlock Text="先看公司成员和正在做的工作，再管理项目、巡场、验收与资料。"
                                        Margin="0,10,0,0"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ConnectionStatusText}"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="导出进行中项目"
                                    Style="{StaticResource DashboardActionButtonStyle}"
                                    Width="148"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ExportActiveProjectsCommand}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                CornerRadius="22"
                                Background="{DynamicResource AccentSoftBrush}"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Text="最近更新"
                                           FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding RecentUpdates}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RecentProjectUpdate}">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding DashboardCards}"
                              Margin="0,0,0,20"
                              HorizontalContentAlignment="Stretch"
                              Visibility="{Binding OverviewVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DashboardCard}">
                            <Button Command="{Binding DataContext.ToggleDashboardCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Padding="0"
                                    Width="270"
                                    Height="188"
                                    Margin="0,0,18,0">
                                <Border CornerRadius="26"
                                        Padding="22"
                                        Width="270"
                                        Height="188"
                                        Background="#F9FAFC"
                                        BorderBrush="#E6E8EE"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontWeight="SemiBold" />
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Value}"
                                                   FontSize="32"
                                                   FontWeight="SemiBold"
                                                   Margin="0,10,0,8" />
                                        <Border Grid.Row="2"
                                                Height="8"
                                                CornerRadius="4"
                                                Background="#E9EDF3">
                                            <Border Height="8"
                                                    Width="92"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Left" />
                                        </Border>
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding Subtitle}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Margin="0,10,0,0" />
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2"
                        Style="{StaticResource PanelBorderStyle}"
                        Visibility="{Binding DashboardDetailVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding ExpandedDashboardCard.Title}"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExpandedDashboardCard.Subtitle}"
                                   Margin="0,6,0,16"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ItemsControl ItemsSource="{Binding ExpandedDashboardCard.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DashboardDetailGroup}">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:DashboardDetailItem}">
                                                    <Button Command="{Binding DataContext.OpenDashboardDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F4F6F9"
                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="12,8"
                                                            Margin="0,0,8,8"
                                                            MinHeight="54">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Subtitle}"
                                                                           Margin="0,3,0,0"
                                                                           FontSize="13"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Border Style="{StaticResource PanelBorderStyle}" Visibility="{Binding PeopleVisibility}">
                        <TabControl ItemsSource="{Binding DepartmentPages}"
                                    SelectedItem="{Binding SelectedDepartmentPage}"
                                    Style="{StaticResource DepartmentTabControlStyle}"
                                    ItemContainerStyle="{StaticResource DepartmentTabItemStyle}"
                                    ContentTemplate="{StaticResource PeopleDepartmentTemplate}" />
                    </Border>

                    <Border Style="{StaticResource PanelBorderStyle}" Visibility="{Binding SettingsVisibility}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="后台设置"
                                           FontSize="32"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="管理删除员工、删除项目、导出公司所有项目时使用的确认密码。"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="24"
                                    Padding="24"
                                    MaxWidth="620"
                                    HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="敏感操作确认密码"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16" />

                                    <TextBlock Text="当前密码"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <PasswordBox helpers:PasswordBoxBinder.BoundPassword="{Binding SensitiveCurrentPassword, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,14" />

                                    <TextBlock Text="新密码"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <PasswordBox helpers:PasswordBoxBinder.BoundPassword="{Binding SensitiveNewPassword, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,14" />

                                    <TextBlock Text="确认新密码"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />
                                    <PasswordBox helpers:PasswordBoxBinder.BoundPassword="{Binding SensitiveConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,20" />

                                    <Button Content="保存密码"
                                            Width="120"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ChangeSensitivePasswordCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Column="1"
                Margin="8,20,20,20"
                Style="{StaticResource PanelBorderStyle}"
                Visibility="{Binding ProjectCenterVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="3">
                        <TextBlock Text="项目中心"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="按年份、月份和项目名称归档，右侧查看项目详情和完成进度。"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#EEF3F4F7"
                            CornerRadius="20"
                            Padding="16"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            MinWidth="560">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="128" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="项目名" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="请输入项目名字"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="2" Text="类型" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding NewProjectType, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="请输入项目类型"
                                     Margin="0,0,10,0" />
                            <TextBlock Grid.Column="4"
                                       Text="日期"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="SemiBold" />
                            <Border Grid.Column="5"
                                    Background="#B8FFFFFF"
                                    BorderBrush="#88FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="8,4"
                                    Height="38"
                                    Margin="0,0,10,0">
                                <DatePicker SelectedDate="{Binding NewProjectStartDate, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateFormat="Short"
                                            Language="zh-CN" />
                            </Border>
                            <Button Grid.Column="6"
                                    Content="创建项目"
                                    MinWidth="120"
                                    Margin="0"
                                    Command="{Binding CreateProjectCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#EEF3F4F7"
                            CornerRadius="24"
                            Padding="16"
                            Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox Text="{Binding ProjectSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="搜索项目名称"
                                     Margin="0,0,0,12" />

                            <TreeView Grid.Row="1"
                                      ItemsSource="{Binding ProjectTreeGroups}"
                                      SelectedItemChanged="ProjectTree_SelectedItemChanged"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="17">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>

                            <Button Grid.Row="2"
                                    Content="导出公司所有项目"
                                    Margin="0,14,0,0"
                                    Command="{Binding ExportAllProjectsCommand}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#F7F8FA"
                            CornerRadius="24"
                            Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EditableProjectName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="28"
                                             FontWeight="SemiBold"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="×"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DeleteSelectedProjectCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EditableProjectOperators, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="请输入操作人员"
                                             Margin="0,0,10,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditableProjectType, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="请输入项目类型"
                                             Margin="0,0,10,0" />
                                    <Button Grid.Column="2"
                                            Content="保存"
                                            Margin="0,0,10,8"
                                            Command="{Binding SaveProjectDetailCommand}" />
                                    <Button Grid.Column="3"
                                            Content="导出PDF"
                                            Command="{Binding ExportSelectedProjectDetailCommand}" />
                                </Grid>

                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="项目详情" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <TextBox Text="{Binding EditableProjectSummary, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="请输入项目详情内容"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MinHeight="180"
                                                 VerticalContentAlignment="Top" />
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="跟进计划" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <TextBox Text="{Binding EditableTaskPlanText, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="请输入项目的跟进计划"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     MinHeight="320"
                                                     VerticalContentAlignment="Top" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="跟进完成进度" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <ItemsControl ItemsSource="{Binding SelectedProjectFollowUps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ProjectFollowUp}">
                                                        <Border Background="#EEF3F4F7" CornerRadius="16" Padding="12" Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Content}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                                                        <Run Text="{Binding OperatorName}" />
                                                                        <Run Text="  ·  " />
                                                                        <Run Text="{Binding CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Content="×"
                                                                        Style="{StaticResource IconButtonStyle}"
                                                                        Margin="10,0,0,0"
                                                                        Command="{Binding DataContext.DeleteProjectFollowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>


