<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.0.9</Version>
    <AssemblyVersion>1.0.9.0</AssemblyVersion>
    <FileVersion>1.0.9.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\fanxiang-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="QuestPDF" Version="2024.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\DecorationProjectScheduler.Shared\DecorationProjectScheduler.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DecorationProjectScheduler.Updater\bin\Release\net8.0-windows\win-x64\publish\DecorationProjectScheduler.Updater.exe"
          Link="DecorationProjectScheduler.Updater.next.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\DecorationProjectScheduler.Updater\bin\Release\net8.0-windows\win-x64\publish\DecorationProjectScheduler.Updater.exe')" />
  </ItemGroup>

</Project>
